{
  "name": "onlyevent-quality",
  "private": true,
  "type": "module",
  "scripts": {
    "contract": "node ./check-renderer-contract.mjs",
    "unit": "node --test ./tests/*.test.mjs",
    "smoke": "playwright test",
    "check": "npm run architecture && npm run typecheck && npm run typecheck:editor && npm run contract && npm run unit && npm run smoke",
    "typecheck": "tsc -p ./tsconfig.json",
    "typecheck:editor": "tsc -p ./tsconfig.editor.json",
    "css:audit": "node ../tools/audit-css-important.mjs",
    "architecture": "node ../tools/check-architecture.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "typescript": "5.9.3"
  }
}
