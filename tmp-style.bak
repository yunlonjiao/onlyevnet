import {test} from '@playwright/test';
import {writeFileSync} from 'node:fs';
const ids=['01-ip-only','02-scrapbook','03-creator-market','04-creator-catalogue','05-live-poster','06-band-live','07-tea-party','08-birthday'];
test('style tokens',async({browser})=>{
  test.setTimeout(280000);
  const out={};
  for(const id of ids){
    const ctx=await browser.newContext({viewport:{width:1440,height:900}});
    const page=await ctx.newPage();
    await page.goto('/v8/?template='+id+'&project=tok');
    const frame=page.frameLocator('#liveFrame');
    await frame.locator('.hero,.cm-site,.cc-site,.scrap-entry').first().waitFor({state:'attached'});
    await page.waitForTimeout(1800);
    await page.locator('#previewBtn').click().catch(()=>{});await page.waitForTimeout(800);
    await page.evaluate(()=>{const d=document.querySelector('#liveFrame').contentDocument;d.querySelectorAll('#loader,.loader').forEach(e=>e.remove())});
    await page.waitForTimeout(600);
    out[id]=await page.evaluate(()=>{
      const d=document.querySelector('#liveFrame').contentDocument,w=d.defaultView,cs=e=>e?w.getComputedStyle(e):null;
      const first=sel=>d.querySelector(sel);
      const solid=e=>{while(e&&e!==d.documentElement){const c=cs(e).backgroundColor;if(c&&c!=='rgba(0, 0, 0, 0)'&&!c.endsWith(', 0)'))return c;e=e.parentElement}return cs(d.documentElement).backgroundColor||cs(d.body).backgroundColor};
      const shadow=e=>{const s=cs(e)?.boxShadow||'none';if(s==='none')return 'none';const m=s.match(/(-?\d+)px (-?\d+)px (\d+)px/);if(!m)return 'soft';return (+m[3]===0&&(+m[1]||+m[2]))?'hard':'soft'};
      const card=first('.ticket')||first('.guest-card')||first('.booth-directory-card');
      const h2=first('.head h2')||first('h2');const h1=first('.hero h1')||first('h1');
      const btn=first('.nav .btn')||first('.ticket-purchase-link');
      const section=first('.section')||first('main');
      return {
        page:solid(first('.section')||d.body),hero:solid(first('.hero')||d.body),btn:btn?cs(btn).backgroundColor:'',navBg:solid(first('.nav')||d.body),
        h2font:h2?cs(h2).fontFamily.split(',')[0].replace(/\"/g,''):'',h2italic:h2?cs(h2).fontStyle:'',h2weight:h2?cs(h2).fontWeight:'',
        h1font:h1?cs(h1).fontFamily.split(',')[0].replace(/\"/g,''):'',h1italic:h1?cs(h1).fontStyle:'',h1transform:h1?cs(h1).textTransform:'',
        headAlign:first('.head')?(cs(first('.head')).alignItems+'/'+cs(first('.head')).justifyContent+'/'+cs(first('.head')).textAlign):'',
        cardRadius:card?cs(card).borderRadius:'',cardBorder:card?cs(card).borderTopWidth+' '+cs(card).borderTopStyle:'',cardShadow:card?shadow(card):'',cardBg:card?cs(card).backgroundColor:'',
        heroCols:first('.hero-grid')?cs(first('.hero-grid')).gridTemplateColumns.split(' ').length:0,
        bodyFont:cs(d.body).fontFamily.split(',')[0].replace(/\"/g,'')
      };
    });
    await ctx.close();
  }
  writeFileSync('C:/c/Users/32224/AppData/Local/Temp/claude/C--Users-32224-Documents-Codex-2026-07-07-en/cc0fd065-8d8c-48b0-a902-c0f1fc76ad1b/scratchpad/tokens.json',JSON.stringify(out,null,1));
});
